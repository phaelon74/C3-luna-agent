[Unit]
Description=Mose host - prune unused Docker images (oneshot)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=mose
Group=docker
WorkingDirectory=/home/mose/mose-agent
ExecStart=/home/mose/mose-agent/scripts/docker-prune-unused.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

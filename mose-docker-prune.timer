[Unit]
Description=Weekly prune of unused Docker images on the Mose host

[Timer]
# Every Sunday at 04:00 local time. Adjust OnCalendar to taste.
OnCalendar=Sun *-*-* 04:00:00
# If the host was off at the scheduled time, run on next boot.
Persistent=true
RandomizedDelaySec=30m
Unit=mose-docker-prune.service

[Install]
WantedBy=timers.target
